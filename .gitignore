# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs
*.log

# --- Build output ---
dist/
dist-ssr/
*.local

# --- Environment / secrets ---
# No .env file is committed. Create one locally and fill it in; never commit
# real credentials.
.env
.env.*
!.env.example

