.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.orig
*.rej

# --- Testing ---
test-results/
playwright-report/
blob-report/
.playwright/
coverage/

# --- Screenshot / visual-QA output ---
qa-screenshots/
qa/shots/
qa/phase1-final/

