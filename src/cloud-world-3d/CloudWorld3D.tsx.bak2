        <sphereGeometry args={[1, 32, 16]} />
        <meshStandardMaterial color="#D2B48C" roughness={0.9} metalness={0.02} flatShading={true} />
      </mesh>
      <mesh receiveShadow castShadow position={[0, -1, -60]} rotation={[0, -0.05, 0]} scale={[100, 20, 60]}>
        <sphereGeometry args={[1, 32, 16]} />
        <meshStandardMaterial color="#D2B48C" roughness={0.9} metalness={0.02} flatShading={true} />
