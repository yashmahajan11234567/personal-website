    technologies: ['Excel', 'Tableau', 'Power BI']
  }
];

interface CloudWorld3DProps {
  onExit: () => void;
}

export const CloudWorld3D = ({ onExit }: CloudWorld3DProps) => {
  const [reducedMotion, setReducedMotion] = useState(false);
  const [webglAvailable, setWebglAvailable] = useState(true);
  const containerRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    setReducedMotion(mediaQuery.matches);
    const handler = (e: MediaQueryListEvent) => setReducedMotion(e.matches);
    mediaQuery.addEventListener('change', handler);
    return () => mediaQuery.removeEventListener('change', handler);
  }, []);

  useEffect(() => {
    const canvas = document.createElement('canvas');
    try {
      const gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
      setWebglAvailable(!!gl);
    } catch {
      setWebglAvailable(false);
    }
  }, []);

  const handleKeyDown = (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      onExit();
    }
  };

  useEffect(() => {
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [onExit]);

  if (!webglAvailable) {
    return (
      <div className="cloud-world-fallback" role="region" aria-label="Cloud World - WebGL not available">
        <div className="fallback-content">
          <h1>Cloud World</h1>
          <p>Your browser doesn't support WebGL, which is required for the 3D experience.</p>
          <button onClick={onExit} className="exit-button">Return to Portfolio</button>
        </div>
      </div>
    );
  }

  if (reducedMotion) {
    return (
      <div className="cloud-world-reduced" role="region" aria-label="Cloud World - Reduced motion">
        <div className="reduced-content">
          <h1>Cloud World</h1>
          <p>Reduced motion is enabled. The 3D experience is disabled for comfort.</p>
          <button onClick={onExit} className="exit-button">Return to Portfolio</button>
        </div>
      </div>
    );
  }

  return (
    <div className="cloud-world-container" ref={containerRef}>
      <Canvas
        camera={{ position: [0, 15, -10], fov: 55, near: 1, far: 300 }}
        onCreated={({ gl }) => {
          gl.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        }}
        style={{ touchAction: 'none' }}
      >
        <color attach="background" args={['#FFF5E1']} />
        <fog attach="fog" args={['#FFDAB9', 50, 250]} />

        {/* Valley lighting - warm sunset from left as in reference */}
        <hemisphereLight intensity={0.6} groundColor="#4A7C59" color="#FFF5E1" />
        <directionalLight position={[-30, 50, -20]} intensity={1.8} castShadow>
          <orthographicCamera
            attach="shadowCamera"
            args={[-80, 80, 80, -80, 0.1, 300]}
          />
        </directionalLight>

        {/* Only Skills Valley for now */}
        <SkillsValleyZone />

        {/* Skill markers */}
        {SKILL_STOPS.map(stop => (
          <SkillMarker key={stop.id} stop={stop} />
        ))}

        <CloudCharacter />

        {/* Constrained OrbitControls - limited rotation to prevent breaking the journey */}
        <OrbitControls
          enablePan={false}
          enableZoom={true}
          enableRotate={true}
          minDistance={15}
          maxDistance={60}
          minPolarAngle={Math.PI * 0.15}
          maxPolarAngle={Math.PI * 0.7}
          target={[0, 8, 10]}
          enableDamping={true}
          dampingFactor={0.05}
          rotateSpeed={0.4}
          zoomSpeed={0.5}
        />
      </Canvas>

      {/* Interactive overlay for skill/project details - regular React overlay, NOT drei's Html */}
      <div className="cloud-world-overlay">
        <div className="overlay-content">
          <header className="overlay-header">
            <h2 id="overlay-title">Cloud World</h2>
            <button onClick={onExit} className="exit-button" aria-label="Exit Cloud World">×</button>
          </header>
          <main className="overlay-main">
            <div id="overlay-body">
              <p className="placeholder-text">
                Journey through Skills Valley → Mountain Passage → Projects Sunset
              </p>
              <div className="journey-hint">
                <kbd>WASD</kbd> / <kbd>Arrow Keys</kbd> Move Character &nbsp;
                <kbd>Mouse</kbd> Look Around &nbsp;
                <kbd>Click</kbd> on markers for details &nbsp;
                <kbd>Esc</kbd> Exit
              </div>
            </div>
          </main>
        </div>
      </div>
    </div>
  );
};

