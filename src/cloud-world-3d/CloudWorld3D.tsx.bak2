import { useEffect, useRef, useState } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import { OrbitControls, Html } from '@react-three/drei';
import * as THREE from 'three';
import './CloudWorld3D.css';

// Skill stops data from projects.data.ts
const SKILL_STOPS = [
  { id: 'aws', name: 'AWS', x: -20, z: 0, side: 'left' },
  { id: 'terraform', name: 'Terraform', x: 20, z: 0, side: 'right' },
  { id: 'docker', name: 'Docker', x: -20, z: 20, side: 'left' },
  { id: 'kubernetes', name: 'Kubernetes', x: 20, z: 20, side: 'right' },
  { id: 'linux', name: 'Linux', x: -20, z: 40, side: 'left' },
  { id: 'git', name: 'Git', x: 20, z: 40, side: 'right' },
  { id: 'cicd', name: 'CI/CD', x: -20, z: 60, side: 'left' }
];

// Project data from projects.data.ts
const PROJECT_DATA = [
  {
    id: 'nifty100-financial-analysis',
    title: 'Nifty-100 Financial Analysis',
    github: 'https://github.com/yashmahajan11234567/Bluestock_fintech',
